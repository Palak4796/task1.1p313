pipeline {
    agent any

    environment {
        GITHUB_REPO = 'https://github.com/Palak4796/task1.1p313.git'
        EMAIL = 'palakdankher@gmail.com'
    }

    triggers {
        pollSCM('H/2 * * * *') // Polls GitHub every 2 minutes
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Tool can be used: Git, GitHub CLI, GitLab SCM Plugin'
                echo ' Cloning the project repository from GitHub'
                git branch: 'main', url: "${GITHUB_REPO}"
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Checkout Code - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Checkout stage completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Build') {
            steps {
                echo 'Tool can be used: Maven, Gradle, Ant, Bazel'
                echo ' Building the project to ensure all dependencies and code compile correctly'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Build - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Build stage completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Unit and Integration Tests') {
            steps {
                echo 'Tool can be used: JUnit via Maven, TestNG, Spock, NUnit (for .NET)'
                echo 'Executes unit and integration tests to verify code functionality and correctness.'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Unit & Integration Tests - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Test stage completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Code Analysis') {
            steps {
                echo 'Tool can be used: SonarQube, PMD, Checkstyle, CodeClimate'
                echo ' Performs static code analysis  to detect bugs and maintain code quality.'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Code Analysis - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Code analysis stage completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Security Scan') {
            steps {
                echo 'Tool can be used: OWASP Dependency-Check, Snyk, Sonatype Nexus, Whitesource'
                echo 'Runs OWASP Dependency-Check to identify known vulnerabilities in dependencies'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Security Scan - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Security scan stage completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Deploy to Staging') {
            steps {
                echo 'Tool  can be used: WinSCP, Ansible, Jenkins Publish Over SSH, FTP'
                echo 'Transfers the built application to a staging server for pre-production testing'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Deploy to Staging - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Deployment to staging completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Integration Tests on Staging') {
            steps {
                echo 'Tool can be used: Postman, JUnit, REST Assured, Karate DSL, Newman CLI'
                echo 'Executes integration tests on the staging server to simulate real-world usage'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Integration Tests on Staging - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Integration tests on staging completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Approval') {
            steps {
                echo 'Simulating Manual Approval - Tool can be used : Slack Approval Plugin, Jira Integration'
                echo 'Introduces a manual approval step before deploying to production to ensure verification'
                sleep 10
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Approval - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Approval stage simulated with sleep. Status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Tool can be used: WinSCP, SCP, Ansible, Docker, Kubernetes, Jenkins FTP plugin'
                echo 'Deploys the final, tested build to the production server for end-user access'
            }
            post {
                always {
                    emailext(
                        subject: "Stage: Deploy to Production - ${currentBuild.currentResult}",
                        to: "${EMAIL}",
                        attachLog: true,
                        body: "Deployment to production completed with status: ${currentBuild.currentResult}.\nSee attached logs."
                    )
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline completed with status: ${currentBuild.currentResult}"
        }
    }
}
